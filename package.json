{
  "name": "businesstemplate",
  "description": "Law-firm template page (Qwik + Tailwind v3 + Vite)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "vite --mode ssr",
    "dev:direct": "node node_modules/vite/bin/vite.js --mode ssr",
    "build": "qwik build",
    "build:direct": "node node_modules/vite/bin/vite.js build",
    "build.types": "tsc --incremental --noEmit",
    "build.types:direct": "node node_modules/typescript/bin/tsc --incremental --noEmit",
    "preview": "vite preview",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.0",
    "ignore": "^5.3.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
